# Shared Supabase project values. Copy to apps/web/.env.local and apps/mobile/.env.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_GIT_SHA=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GIT_SHA=
# Server-only Sentry configuration; source-map upload requires the auth token in CI/EAS only.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
GIT_SHA=
# Server-only; never expose this to a client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Payments remain disabled until provider credentials, webhooks, refunds, and compliance are verified.
PAYMENTS_LIVE_ENABLED=false
PAYMENT_PROVIDER_GB=stripe
PAYMENT_PROVIDER_IN=razorpay
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Application notifications only; keep these server-side and configure a worker/cron.
OUTBOX_EMAIL_WEBHOOK_URL=
OUTBOX_SMS_WEBHOOK_URL=
OUTBOX_PROVIDER_TOKEN=
