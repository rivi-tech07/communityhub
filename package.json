{
  "name": "communityhub",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev:web": "pnpm --filter @communityhub/web dev",
    "dev:mobile": "pnpm --filter @communityhub/mobile start",
    "build:web": "pnpm --filter @communityhub/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run"
    ,"release:check": "tsx scripts/release-check.ts"
  },
  "devDependencies": {
    "@communityhub/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supabase": "^1.226.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
