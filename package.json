{
  "name": "communityhub",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev:web": "pnpm --filter @communityhub/web dev",
    "dev:mobile": "pnpm --filter @communityhub/mobile start",
    "build:web": "pnpm --filter @communityhub/web build",
    "e2e:web": "pnpm --filter @communityhub/web exec playwright test -c playwright.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:leaks": "node scripts/check-service-role-leak.mjs",
    "check:mobile-no-payments": "node scripts/check-mobile-no-payments.mjs",
    "audit:high": "pnpm audit --audit-level high",
    "prepare": "node scripts/install-git-hooks.mjs",
    "eas-build-pre-install": "pnpm check:mobile-no-payments",
    "typecheck": "tsc -b",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:seed": "tsx scripts/seed.ts",
    "reconcile:stock": "node scripts/reconcile-stock.mjs",
    "process:deletions": "node scripts/process-deletions.mjs",
    "process:outbox": "node scripts/process-outbox.mjs",
    "export:user-data": "node scripts/export-user-data.mjs",
    "purge:soft-deleted": "node scripts/purge-soft-deleted.mjs",
    "purge:samples": "node scripts/purge-sample-data.mjs",
    "purge:audit-logs": "node scripts/purge-audit-logs.mjs",
    "test": "vitest run",
    "release:check": "tsx scripts/release-check.ts",
    "release:version": "changeset version && pnpm install --lockfile-only && node scripts/sync-release-metadata.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@communityhub/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.4.2",
    "supabase": "^2.122.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
