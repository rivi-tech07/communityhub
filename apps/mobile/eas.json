{
  "cli": { "version": ">= 10.0.0", "appVersionSource": "local", "requireCommit": true },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_WEB_URL": "https://communityhub-lyart.vercel.app",
        "EXPO_PUBLIC_RESET_PASSWORD_URL": "https://communityhub-lyart.vercel.app/reset-password"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_WEB_URL": "https://communityhub-lyart.vercel.app",
        "EXPO_PUBLIC_RESET_PASSWORD_URL": "https://communityhub-lyart.vercel.app/reset-password"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_WEB_URL": "https://communityhub-lyart.vercel.app",
        "EXPO_PUBLIC_RESET_PASSWORD_URL": "https://communityhub-lyart.vercel.app/reset-password"
      }
    }
  },
  "submit": {
    "preview": { "android": { "track": "internal" } },
    "production": {
      "android": { "track": "internal" },
      "ios": { "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID" }
    }
  }
}
